  "author": "Gentaine",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "qq",
    "qq-bridge",
    "memory",
    "sqlite"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gentaine/dsh-qq-memory.git"
  },
  "homepage": "https://github.com/Gentaine/dsh-qq-memory",
  "bugs": {
    "url": "https://github.com/Gentaine/dsh-qq-memory/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "lib/",
    "scripts/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-isolation=none"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
